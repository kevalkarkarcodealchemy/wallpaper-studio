{
  "expo": {
    "name": "WallpaperApp",
    "slug": "WallpaperApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Appicon.png",
    "scheme": "wallpaperapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/Appicon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#060235",
        "foregroundImage": "./assets/images/AdaptiveIcon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#060235",
          "image": "./assets/images/Appicon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
